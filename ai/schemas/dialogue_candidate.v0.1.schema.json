{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://btl-ai.invalid/schemas/dialogue_candidate.v0.1.schema.json",
  "title": "Frozen v0.1 Dialogue Semantic Candidate",
  "type": "object",
  "required": ["status"],
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": ["RESOLVED", "AMBIGUOUS", "UNSUPPORTED"]
    },
    "reason": {
      "enum": [
        "AMBIGUOUS_REFERENCE",
        "INSUFFICIENT_CONTEXT",
        "MULTIPLE_ACTIONS",
        "OUT_OF_CATALOGUE",
        "UNSUPPORTED_ACTION"
      ]
    },
    "act": {
      "enum": ["QUESTION", "ASSERTION", "REQUEST", "OFFER", "ACCEPT", "REFUSE"]
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "value_id": {
      "type": "string",
      "minLength": 1
    },
    "polarity": {
      "enum": ["AFFIRM", "DENY"]
    },
    "tactics": {
      "type": "array",
      "items": {
        "enum": ["THREAT", "ACCUSATION", "INDIRECT_PROBE"]
      },
      "uniqueItems": true
    },
    "evidence_ref_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": {"const": "RESOLVED"}
      },
      "required": ["act"],
      "not": {"required": ["reason"]}
    },
    {
      "properties": {
        "status": {"enum": ["AMBIGUOUS", "UNSUPPORTED"]}
      },
      "not": {
        "anyOf": [
          {"required": ["act"]},
          {"required": ["target_id"]},
          {"required": ["value_id"]},
          {"required": ["polarity"]},
          {"required": ["tactics"]},
          {"required": ["evidence_ref_ids"]}
        ]
      }
    }
  ]
}
