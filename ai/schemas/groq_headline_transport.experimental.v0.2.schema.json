{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://btl-ai.invalid/schemas/groq_headline_transport.experimental.v0.2.schema.json",
  "title": "Experimental Groq Headline Transport v0.2",
  "description": "Provider wire format only. This is not a Frozen semantic schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result"
  ],
  "properties": {
    "result": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "claims"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "RESOLVED"
              ]
            },
            "reason": {
              "type": "null"
            },
            "claims": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/claim_atom_transport"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "claims"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "AMBIGUOUS",
                "UNSUPPORTED"
              ]
            },
            "reason": {
              "type": "string",
              "enum": [
                "AMBIGUOUS_REFERENCE",
                "INSUFFICIENT_CONTEXT",
                "MULTIPLE_ACTIONS",
                "OUT_OF_CATALOGUE",
                "UNSUPPORTED_ACTION"
              ]
            },
            "claims": {
              "type": "null"
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "claim_atom_transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "value_id",
        "polarity",
        "commitment_mode",
        "source_ref_id"
      ],
      "properties": {
        "target_id": {
          "type": "string"
        },
        "value_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "polarity": {
          "enum": [
            "AFFIRM",
            "DENY",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "commitment_mode": {
          "enum": [
            "ASSERTED",
            "SPECULATIVE",
            "QUESTIONED"
          ],
          "type": "string"
        },
        "source_ref_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
