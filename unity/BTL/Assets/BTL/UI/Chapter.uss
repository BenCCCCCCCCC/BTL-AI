.chapter-root { flex-grow: 1; background-color: #19252e; color: #27363b; }
Label { white-space: normal; flex-shrink: 0; -unity-text-align: upper-left; }
.body { margin-bottom: 18px; }
.small { margin-bottom: 10px; color: #65706a; }
.title { margin-top: 5px; margin-bottom: 14px; -unity-font-style: bold; }
.heading { margin-top: 0; margin-bottom: 24px; -unity-font-style: bold; }
.topbar { flex-direction: row; align-items: center; height: 64px; flex-shrink: 0; padding-left: 24px; padding-right: 20px; }
.topbar Label { color: #e0d6bf; margin-bottom: 0; }
.stages { flex-grow: 1; padding-left: 25px; }
.topbar Button { min-height: 34px; margin-left: 12px; padding-top: 4px; padding-bottom: 4px; background-color: #34454b; color: #e4dcc9; }
.topbar Button:hover, .topbar Button:focus { background-color: #46605e; color: #fff3dc; }
.hero { height: 170px; flex-shrink: 0; overflow: hidden; background-color: #2d3e44; }
.scene-image { position: absolute; right: 10px; top: 0; bottom: 0; width: 390px; }
.hero-veil { flex-direction: row; height: 170px; align-items: center; padding-left: 24px; padding-right: 400px; }
.portrait { width: 100px; height: 120px; flex-shrink: 0; margin-right: 24px; background-color: rgba(25,37,46,0.50); }
.person { flex-shrink: 1; min-width: 0; }
.person Label { color: #f1e6cf; }
.person .heading { margin-bottom: 4px; }
.person .small { margin-bottom: 3px; }
.status { flex-shrink: 0; flex-direction: row; justify-content: space-between; padding: 9px 24px; background-color: #273941; }
.status Label { color: #d6cbb3; margin-bottom: 0; }
.columns { flex-grow: 1; flex-direction: row; min-height: 0; padding: 14px 18px 16px; }
.main-scroll { flex-grow: 1; width: 70%; min-width: 0; background-color: #f0eadc; padding: 25px 28px 16px; }
.dossier { width: 30%; min-width: 275px; margin-left: 14px; background-color: #dcd7c6; padding: 20px; }
.action, .primary { min-height: 44px; flex-shrink: 0; white-space: normal; padding: 10px 16px; margin: 0 0 10px; border-width: 1px; border-color: #b4b5a6; border-radius: 2px; background-color: #e3dfd1; color: #26383e; -unity-text-align: middle-left; }
.action:hover { background-color: #d0d4c7; border-color: #758e87; }
.action:focus { border-color: #597c75; border-width: 2px; }
.primary { background-color: #7d403b; color: #fcf1db; border-color: #7d403b; }
.primary:hover { background-color: #955249; }
.primary:focus { border-color: #dcad68; border-width: 2px; }
.note { padding: 16px 18px 0; margin-bottom: 18px; background-color: #e0dfcd; border-left-width: 3px; border-left-color: #798c79; }
.route-card { padding: 18px 20px 8px; margin-bottom: 14px; background-color: #e6e2d5; border-top-width: 1px; border-top-color: #bdbba9; }
.material-card { padding: 20px 20px 4px; margin: 12px 0 18px; border-width: 1px; border-color: #b4b3a1; background-color: #f8f0df; }
.review-card { padding: 20px 22px 4px; margin-bottom: 18px; background-color: #e4e2d5; border-left-width: 4px; border-left-color: #7c8f80; }
.headline-paper { padding: 23px 24px 12px; margin-bottom: 22px; background-color: #fbf4e4; border-bottom-width: 3px; border-bottom-color: #7e4b44; }
.reply { padding: 18px 20px 0; margin-bottom: 18px; background-color: #dddccc; }
.selected-expression { padding: 18px 20px 4px; margin-bottom: 18px; background-color: #faf4e6; border-left-width: 3px; border-left-color: #7d403b; }
.aftermath-scene { padding: 22px 24px 8px; margin-bottom: 20px; background-color: #f8f1e2; border-left-width: 3px; border-left-color: #8b9787; }
.draft { min-height: 112px; flex-shrink: 0; margin-bottom: 15px; white-space: normal; }
.draft > .unity-text-field__input { white-space: normal; padding: 14px; background-color: #faf6eb; color: #25353c; border-color: #89998d; }
.tabs { flex-direction: row; margin-bottom: 8px; }
.tabs Button { flex-grow: 1; margin-right: 8px; -unity-text-align: middle-center; }
Foldout { margin: 7px 0 17px; flex-shrink: 0; }
.unity-foldout__toggle { font-size: 19px; min-height: 38px; white-space: normal; }
.unity-foldout__content { padding: 12px 8px 0 15px; }
.path-step { border-left-width: 2px; border-left-color: #8b9787; padding-left: 8px; }
.error { color: #8b3935; }
.modal-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(10,20,26,0.85); }
.modal { width: 570px; max-width: 90%; padding: 32px; background-color: #eee6d5; }
